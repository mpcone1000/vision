{
  "actorSpecification": 1,
  "name": "google-hotels-scraper",
  "title": "Google Hotels Scraper",
  "description": "Scrape hotel prices, ratings, reviews count, deals and amenities from Google Hotels for any city and travel dates.",
  "version": "0.1",
  "buildTag": "latest",
  "input": "./input_schema.json",
  "dockerfile": "../Dockerfile",
  "storages": {
    "dataset": {
      "actorSpecification": 1,
      "views": {
        "overview": {
          "title": "Hotels",
          "transformation": {
            "fields": ["location", "position", "name", "pricePerNight", "totalPrice", "currency", "nights", "rating", "reviewCount", "deal", "dealPercentBelowUsual", "url"]
          },
          "display": {
            "component": "table",
            "properties": {
              "url": { "label": "Google Hotels link", "format": "link" }
            }
          }
        }
      }
    }
  }
}
